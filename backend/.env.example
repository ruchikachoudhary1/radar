# Copy this file to `.env` and fill in your values.
# The app runs fully without a key — AI rewriting falls back to a rule-based engine.

# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the model (default gemini-1.5-flash — free tier friendly)
GEMINI_MODEL=gemini-1.5-flash

# Optional: backend port (default 8000)
PORT=8000

# --- Database --------------------------------------------------------------
# Leave blank for local development: the app uses a SQLite file at
# backend/data/radar.db. In production set this to a hosted PostgreSQL URL —
# free hosting tiers wipe the container filesystem on every restart, so a
# SQLite file there loses every account. Neon's free tier works.
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Sessions --------------------------------------------------------------
# Signs the JWTs issued at login. Generate a long random value, keep it out of
# git, and do not reuse the development default in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Set to "production" to make a missing JWT_SECRET a hard startup error
# instead of silently falling back to the insecure development key.
RADAR_ENV=

# Comma-separated frontend origins allowed to call this API. Leave blank to
# allow any origin (fine locally, too permissive once deployed).
#   ALLOWED_ORIGINS=https://radar-six-iota.vercel.app
ALLOWED_ORIGINS=
